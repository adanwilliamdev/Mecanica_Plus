# Ambiente: development | production (em production o JWT_SECRET precisa ser forte)
ENVIRONMENT=development

# PostgreSQL (aceita postgresql:// ou postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mecanica

# Redis (cache do dashboard e rate limit de login; a API continua funcionando sem ele)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=troque-este-segredo-em-producao-para-uma-string-longa-e-aleatoria
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_DAYS=7

# CORS - origens permitidas, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limit do login (tentativas por janela, por IP + e-mail)
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Cache do dashboard
DASHBOARD_CACHE_TTL_SECONDS=30

# Usuário criado pelo seed (python -m app.scripts.seed)
SEED_ADMIN_EMAIL=admin@mecanicaplus.com
SEED_ADMIN_PASSWORD=admin123
